# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
dist-ssr/

# Environment / secrets
.env
.env.*
!.env.example
!.env.production.example
!.env.development.example

# Firebase service account / private credentials
*-firebase-adminsdk-*.json
*firebase-adminsdk*.json
firebase-service-account*.json
serviceAccount*.json

# Local database / runtime-generated data
backups/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test artifacts
coverage/
playwright-report/
test-results/
.vitest/

# Temporary patches / generated working files
*.patch
*.tmp
*.bak

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
*.njsproj
*.sln

# Deployment / runtime temporary files
.pids/
*.pid

